<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" type="text/css" href="/css/register.css" />
  <title>Member Login</title>
</head>
<body>
  <div class="container">
    <div class="left">
      <img src="/images/libraryimage.svg" alt="Library Image" />
    </div>
    <div class="right">
      <h1>Member Login</h1>
      <% const authError = typeof error !== 'undefined' ? error : ''; %>
      <% if (authError) { %>
        <div class="alert error"><%= authError %></div>
      <% } %>
      <form action="/login" method="POST" class="form-table">
        <table>
          <tr>
            <td><label for="username">Username</label></td>
            <td><input type="text" name="username" required id="username" placeholder="Username" autocomplete="off"></td>
          </tr>
          <tr>
            <td><label for="password">Password</label></td>
            <td><input type="password" name="password" required id="password" placeholder="Password"></td>
          </tr>
          <tr>
            <td></td>
            <td><button type="submit">Login</button></td>
          </tr>
        </table>
      </form>
      <p><a href="/">Return To Home Page</a></p>
    </div>
  </div>
</body>
</html>
